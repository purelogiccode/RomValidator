<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RomValidator.Pages.ValidatePage">
    <Grid RowDefinitions="*,Auto,Auto">
        <!-- Main content: validation controls on the left, activity log on the right -->
        <Grid Grid.Row="0" Margin="10" ColumnDefinitions="*,8,*">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="150,*,Auto">
                                <TextBlock Grid.Column="0" Text="ROMs Folder to Scan:" Classes="label" />
                                <TextBox x:Name="RomsFolderTextBox"
                                         Grid.Column="1"
                                         Margin="6,0"
                                         IsReadOnly="True"
                                         PlaceholderText="Select the folder containing ROM files" />
                                <Button x:Name="BrowseRomsFolderButton"
                                        Grid.Column="2"
                                        Content="Browse..."
                                        Classes="primary" />
                            </Grid>

                            <Grid ColumnDefinitions="150,*,Auto">
                                <TextBlock Grid.Column="0" Text="DAT File:" Classes="label" />
                                <TextBox x:Name="DatFileTextBox"
                                         Grid.Column="1"
                                         Margin="6,0"
                                         IsReadOnly="True"
                                         PlaceholderText="Select a No-Intro DAT file" />
                                <Button x:Name="BrowseDatFileButton"
                                        Grid.Column="2"
                                        Content="Browse..."
                                        Classes="primary" />
                            </Grid>

                            <TextBlock Text="Only No-Intro XML DAT files are supported."
                                       Classes="hint"
                                       Margin="156,0,0,0" />

                            <Expander Header="Validation Options" IsExpanded="True" Margin="0,4,0,0">
                                <StackPanel Spacing="2" Margin="0,10,0,0">
                                    <CheckBox x:Name="MoveSuccessCheckBox"
                                              Content="Move successful items to '_success' folder"
                                              IsChecked="True" />
                                    <CheckBox x:Name="MoveFailedCheckBox"
                                              Content="Move failed/unknown items to '_fail' folder"
                                              IsChecked="True" />
                                    <CheckBox x:Name="DeleteFailedCheckBox"
                                              Content="Permanently delete failed/unknown files (irreversible)"
                                              IsChecked="False"
                                              Classes="danger" />
                                    <CheckBox x:Name="RenameMatchedFilesCheckBox"
                                              Content="Automatically rename files when hash matches but filename differs"
                                              IsChecked="True" />
                                </StackPanel>
                            </Expander>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="StartValidationButton"
                                        Content="Start Validation"
                                        Classes="start" />
                                <Button x:Name="DownloadDatFilesButton"
                                        Content="Download DAT Files"
                                        Classes="neutral" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="DAT File Information" Classes="section" Margin="0,0,0,4" />
                            <Grid ColumnDefinitions="Auto,*,Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DatNameTextBlock" Text="N/A"
                                           TextWrapping="Wrap" Margin="0,0,18,4" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Version:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="DatVersionTextBlock" Text="N/A"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DatDescriptionTextBlock" Text="N/A"
                                           TextWrapping="Wrap" Margin="0,0,18,4" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Author:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DatAuthorTextBlock" Text="N/A"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Homepage:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DatHomepageTextBlock" Text="N/A"
                                           TextWrapping="Wrap" Margin="0,0,18,4" />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="URL:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="DatUrlTextBlock" Text="N/A"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="ROM Entries:"
                                           Classes="label" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DatRomCountTextBlock" Text="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="8" />

            <Border Grid.Column="2" Classes="card" Padding="4" MinWidth="300">
                <TextBox x:Name="LogViewer"
                         Classes="log"
                         Margin="4"
                         Padding="8"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Top"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         IsReadOnly="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Border>
        </Grid>

        <!-- Statistics -->
        <Grid Grid.Row="1" Margin="10,0,10,10" ColumnDefinitions="*,*,*,*,*,*,*,*">
            <Border Grid.Column="0" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Total Files" Classes="statCategory" />
                    <TextBlock x:Name="TotalFilesValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Success" Classes="statCategory success" />
                    <TextBlock x:Name="SuccessValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Failed" Classes="statCategory failure" />
                    <TextBlock x:Name="FailedValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Unknown" Classes="statCategory warning" />
                    <TextBlock x:Name="UnknownValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Renamed" Classes="statCategory info" />
                    <TextBlock x:Name="RenamedValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Deleted" Classes="statCategory failure" />
                    <TextBlock x:Name="DeletedValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Duplicates" Classes="statCategory warning" />
                    <TextBlock x:Name="DuplicateValue" Text="0" Classes="statValue" />
                </StackPanel>
            </Border>
            <Border Grid.Column="7" Classes="statCard">
                <StackPanel>
                    <TextBlock Text="Processing Time" Classes="statCategory" />
                    <TextBlock x:Name="ProcessingTimeValue" Text="00:00:00" Classes="statValue" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progress -->
        <Grid Grid.Row="2" Margin="10,0,10,10" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderGrayBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Grid>
                    <ProgressBar x:Name="ProgressBar" />
                    <TextBlock x:Name="ProgressText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="11" />
                </Grid>
            </Border>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Classes="danger"
                    Margin="10,0,0,0"
                    IsVisible="False" />
        </Grid>
    </Grid>
</UserControl>
