<Window x:Class="RomValidator.DuplicateFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Duplicate Files Detected"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource WindowBackgroundBrush}"
        ToolTip="Groups of duplicate ROMs detected during DAT generation">
    

    
    <Grid Margin="15" ToolTip="Duplicate ROM groups sharing the same SHA256 hash">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Duplicate Files Detected" Style="{StaticResource DuplicateWindowHeaderTextBlockStyle}"
                   ToolTip="Duplicate ROMs found in the input folder" />
        
        <Border Grid.Row="1" Style="{StaticResource DuplicateWarningBorderStyle}" Margin="0,0,0,15"
                ToolTip="Duplicate ROMs contain identical data but have different filenames">
            <StackPanel ToolTip="Duplicate ROMs contain identical data but have different filenames">
                <TextBlock Text="Warning: Duplicate ROMs detected in the input folder!" Style="{StaticResource DuplicateWarningTitleTextBlockStyle}" ToolTip="Duplicate ROMs were detected in the input folder" />
                <TextBlock Text="These are the same ROM data stored under different filenames." Margin="0,5,0,0" ToolTip="The duplicate files contain identical ROM data" />
                <TextBlock Text="Consider removing duplicates before exporting the DAT file." Margin="0,2,0,0" ToolTip="Removing duplicates keeps the generated DAT file clean" />
            </StackPanel>
        </Border>
        
        <Border Grid.Row="2" Style="{StaticResource DuplicateListContainerBorderStyle}" Margin="0,0,0,15"
                ToolTip="List of duplicate groups and their filenames">
            <Grid ToolTip="List of duplicate groups and their filenames">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Style="{StaticResource DuplicateListHeaderBorderStyle}"
                        ToolTip="Summary of the duplicate groups below">
                    <Grid ToolTip="Summary of the duplicate groups below">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Duplicate Groups:" Style="{StaticResource DuplicateWindowLabelTextBlockStyle}" ToolTip="Number of duplicate groups found" />
                        <TextBlock Grid.Column="1" Text=" (same SHA256 hash, different filenames)" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Files in each group share the same SHA256 hash" />
                        <TextBlock Grid.Column="2" Name="DuplicateCountText" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Number of duplicate groups found" />
                    </Grid>
                </Border>
                
                <ListView Grid.Row="1" Name="DuplicateListView" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ToolTip="Duplicate file groups">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="SHA256 Hash" DisplayMemberBinding="{Binding Hash}" Width="280"/>
                            <GridViewColumn Header="Filenames" DisplayMemberBinding="{Binding Filenames}" Width="400"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        
        <Button Grid.Row="3" Name="CloseButton" Content="Close" Style="{StaticResource DuplicateWindowCloseButtonStyle}" 
                HorizontalAlignment="Right" Width="100" Click="CloseButton_Click"
                ToolTip="Close this window" />
    </Grid>
</Window>
